# EXAMPLE ONLY: no actual credentials. Controlled lab, never an industrial deploy.
HYDRO_PROFILE=postgres_lab
HYDRO_DATABASE_URL=postgresql+psycopg://hk_app:REPLACE@127.0.0.1:5432/hydrokontur_v71_acceptance
HYDRO_AUTH_DATABASE_URL=postgresql+psycopg://hk_authenticator:REPLACE@127.0.0.1:5432/hydrokontur_v71_acceptance
HYDRO_EXPORT_DATABASE_URL=postgresql+psycopg://hk_exporter:REPLACE@127.0.0.1:5432/hydrokontur_v71_acceptance
HYDRO_APP_ORIGIN=https://APP_HOST_APPROVED_BY_OWNER
HYDRO_OIDC_ISSUER=https://IDP_APPROVED_BY_OWNER/realm
HYDRO_OIDC_CLIENT_ID=REGISTER_WITH_IDP
HYDRO_OIDC_REDIRECT_URI=https://APP_HOST_APPROVED_BY_OWNER/v71/auth/callback
HYDRO_REQUIRED_ACR=USE_EXACT_CORPORATE_ASSURANCE_VALUE
HYDRO_JWT_SECRET=GENERATE_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARS
HYDRO_AUDIT_SECRET=GENERATE_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
HYDRO_AUDIT_RECEIVER_URL=https://AUDIT_RECEIVER_APPROVED_BY_OWNER
HYDRO_AUDIT_TRANSPORT_SECRET_FILE=/run/secrets/audit-transport
HYDRO_AUDIT_SIGNING_KEY_FILE=/run/secrets/audit-signing.pem
HYDRO_AUDIT_PUBLIC_KEY_FILE=/run/secrets/audit-public.pem
HYDRO_AUDIT_DATABASE_MAC_FILE=/run/secrets/audit-database-mac
HYDRO_AUDIT_RETENTION_DAYS=30
HYDRO_APPROVED_S3_ENDPOINT=https://OBJECT_STORAGE_APPROVED_BY_OWNER
HYDRO_AUDIT_BUCKET=EXISTING_VERSIONED_OBJECT_LOCK_BUCKET
HYDRO_AUDIT_LAB_DIR=/tmp/hydrokontur-independent-audit
